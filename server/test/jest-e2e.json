{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
  },
  "testEnvironment": "node",
  "moduleDirectories": ["node_modules", "<rootDir>/src"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
