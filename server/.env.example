# Qalm API server environment. Copy to .env and fill in real values.
# .env is gitignored (AGENTS.md: never commit env files or secrets).

# Required. Minimum 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# Postgres connection string for migrations and the app.
DATABASE_URL=postgres://qalm:qalm@localhost:5432/qalm

# Dev API port. The web app assumes 3001 — do not change in development.
PORT=3001

# Refresh cookie Secure attribute. Cookies are always Secure unless this is
# explicitly "true" (plain-HTTP local development only — see api-auth.md).
REFRESH_COOKIE_SECURE=

# Browser origins allowed cross-origin API access in dev (comma-separated
# exact origins, e.g. "http://localhost:3000"). Enables CORS with
# credentials:true so the web app's fetch credentials:include (+ the HttpOnly
# refresh cookie) passes preflight. Empty = CORS disabled. Dev-only.
CORS_DEV_ORIGINS=http://localhost:3000

# Development-only override for the postgres host used by scripts/wait-for-db.js
# (compose sets this itself; leave empty when running against localhost).
PGHOST=
